# HealthGuard — environment template.  Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored.  NEVER commit real values (AUDIT §2.2).

# --- Core -------------------------------------------------------------------
# Generate a fresh one, do not reuse the key that leaked into git history:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-freshly-generated-key

# Never set this to True on a host that is reachable from the internet.
DJANGO_DEBUG=True

# Comma-separated. Must be explicit in production (§2.2).
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Settings module ---------------------------------------------------------
# manage.py defaults to config.settings.dev; production must set this
# explicitly. pytest.ini selects config.settings.test.
#   DJANGO_SETTINGS_MODULE=config.settings.prod

# --- Database ---------------------------------------------------------------
# Postgres is the target (AUDIT §11.1). `docker compose up -d db` gives you one:
#   DATABASE_URL=postgres://healthguard:healthguard@127.0.0.1:5432/healthguard
# SQLite still works for quick local runs.
DATABASE_URL=sqlite:///db.sqlite3

# Run the test suite against Postgres too - SQLite and Postgres disagree about
# enough that passing on one is not evidence for the other. CI should set this.
#   TEST_DATABASE_URL=postgres://healthguard:healthguard@127.0.0.1:5432/healthguard_test

# Seconds to reuse a database connection. Harmless on SQLite, significant on
# Postgres.
DJANGO_CONN_MAX_AGE=60

# --- Admin ------------------------------------------------------------------
# Do not serve the admin from the guessable /admin/ path (AUDIT §8.10).
DJANGO_ADMIN_URL=internal-ops/

# Mandatory second factor for staff. Leave True in production.
# Bootstrap the first device out of band:
#   python manage.py addstatictoken <username>
# then sign in with that backup token and add a TOTP device from the admin.
# Turn it off only for local development, before anyone has enrolled a device.
ADMIN_REQUIRE_2FA=False

# Optional network restriction in front of the admin. Empty = no restriction.
# AUDIT §11.7 (will ops staff be on a fixed IP or VPN?) is unanswered, so this
# ships empty rather than guessing a range and locking you out.
#   ADMIN_IP_ALLOWLIST=10.8.0.0/24,203.0.113.4
ADMIN_IP_ALLOWLIST=

# Staff sessions expire sooner than patient sessions: an admin session is a
# skeleton key to every patient record.
ADMIN_SESSION_TIMEOUT_SECONDS=900

# Login lockout (django-axes). Locks on username+IP together.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30

# --- HTTPS / cookies --------------------------------------------------------
# Applied automatically when DJANGO_DEBUG=False. Override only to debug a
# staging host that has no TLS terminator in front of it.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Frontend (the SPA) ------------------------------------------------------
# Origins allowed to call the API cross-origin. Empty in production: the built
# SPA is served from the same origin, so granting one would be a gift.
# Development settings already allow Vite on :5173.
DJANGO_CORS_ALLOWED_ORIGINS=

# Sign-in is its own throttle scope. An unthrottled API login undoes the
# django-axes lockout, because axes counts attempts per view.
DJANGO_THROTTLE_LOGIN=20/hour

# --- ABDM (AUDIT §4.2) -------------------------------------------------------
# Off by default. Turning it on takes TWO deliberate acts - the flag and
# credentials - because accidentally pointing a development machine at a real
# health network should not be one typo away.
#
# While off, every gateway call goes to a stub and every record is flagged
# simulated=True, so a sandbox-era row is never mistaken for a production one.
# `python manage.py abdm_status` says which mode you are in.
#
# BEFORE ENABLING: the endpoint paths and payload shapes in
# apps/abdm/services/endpoints.py are written from the published specification
# and have NOT been verified against a live sandbox (§11.3 is unanswered).
# Check every one against the current NHA documentation first.
ABDM_ENABLED=False
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_TIMEOUT_SECONDS=10

# --- Logging ----------------------------------------------------------------
# console = readable locally; json = one object per line for an aggregator.
# Production defaults to json.
DJANGO_LOG_FORMAT=console
DJANGO_LOG_LEVEL=INFO
# SQL logging is opt-in: it is noisy, and on a health app it puts patient data
# into the log stream.
DJANGO_SQL_LOG_LEVEL=WARNING

# --- API rate limits --------------------------------------------------------
# An unthrottled triage endpoint is a free inference service; an unthrottled
# intake endpoint is a way to fill the patient table with junk.
DJANGO_THROTTLE_ANON=60/hour
DJANGO_THROTTLE_USER=600/hour
DJANGO_THROTTLE_TRIAGE=30/hour

# --- Production only --------------------------------------------------------
# Comma-separated origins allowed to POST forms, e.g. https://app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Only enable when a proxy actually strips a client-supplied X-Forwarded-Proto,
# otherwise a request can claim to be HTTPS when it is not.
# DJANGO_TRUST_PROXY_SSL_HEADER=False

# --- Retention (AUDIT §4.1) -------------------------------------------------
# The horizons themselves are constants in apps/compliance/models.py rather
# than settings: they are legal obligations, not tuning knobs, and an operator
# should not be able to shorten a notice period by editing an env var.
# Schedule the two passes instead:
#   run_retention --notices   then, later,   run_retention --erase

# --- Development sign-in account --------------------------------------------
# `python manage.py seed_dev_user` creates a local account with a known
# password, and refuses to run unless DEBUG is True - it is a convenience, not a
# deployment feature. Set this to override the default baked into the command.
# DEV_USER_PASSWORD=change-me-locally

# --- Triage tuning (see apps/triage/services/urgency.py) --------------------
# Below this confidence the result abstains instead of naming a condition
# (AUDIT §6 Tier 0.7 — deliberate over-triage).
TRIAGE_ABSTAIN_THRESHOLD=0.40
